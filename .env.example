APP_ENV=development
API_PORT=8000

POSTGRES_DB=meeting_audio
POSTGRES_USER=meeting_app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://meeting_app:change_me@localhost:5432/meeting_audio

JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=speaker_embeddings

MINIO_ROOT_USER=meeting_minio
MINIO_ROOT_PASSWORD=change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_MEETINGS_BUCKET=meeting-audios
MINIO_SPEAKERS_BUCKET=speaker-samples
MINIO_EXPORTS_BUCKET=transcript-exports

ASR_MODEL=AmirMohseni/whisper-large-v3-persian-ct2-int8
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cpu
SPEAKER_EMBEDDING_MODEL=pyannote/embedding
SPEAKER_EMBEDDING_DEVICE=cpu
SPEAKER_SIMILARITY_THRESHOLD=0.80
HUGGINGFACE_TOKEN=

VECTOR_STORE_BACKEND=qdrant
OBJECT_STORAGE_BACKEND=minio
